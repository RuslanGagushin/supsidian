{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supsidian",
  "version": "0.12.0",
  "identifier": "com.supsidian.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Supsidian",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Card board and agenda for Obsidian vaults",
    "longDescription": "Supsidian shows an Obsidian vault as a board of nested cards, with Org-style TODOs, an agenda and git sync between your devices. Notes stay plain Markdown files in your vault.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFNDQyNDQyMzAwMEEyNzUKUldSMW9nQXdRaVJFanUrQ3lKY3FQWEhMcjhIS3IwL29sQmh2dlhSSmZxc1lnUVdIQnhUWG5tc04K",
      "endpoints": [
        "https://github.com/RuslanGagushin/supsidian/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
