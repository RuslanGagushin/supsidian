{
  "name": "supsidian-app",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "description": "Windows, macOS and Android apps for Supsidian (Tauri 2)",
  "scripts": {
    "web": "node scripts/web.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path tauri-plugin-vault/Cargo.toml",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "icons": "tauri icon icon.png",
    "android:init": "tauri android init && tauri icon icon.png",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --target aarch64"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "playwright-core": "1.64.1"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38"
  }
}
